=== a.ts ===
declare module "*" with { type: "css" } {
>"*" : typeof import("*")
>type : error

    const a: { kind: "a" };
>a : { kind: "a"; }
>kind : "a"

    export default a;
>a : { kind: "a"; }
}

declare module "*" {
>"*" : typeof import("*")

    const b: { kind: "b" };
>b : { kind: "b"; }
>kind : "b"

    export default b;
>b : { kind: "b"; }
}

declare module "a:*" with { type: "json" } {
>"a:*" : typeof import("a:*")
>type : error

    const c: { kind: "c" };
>c : { kind: "c"; }
>kind : "c"

    export default c;
>c : { kind: "c"; }
}

declare module "b:c" with { type: "json" } {
>"b:c" : typeof import("b:c")
>type : error

    const d: { kind: "d" };
>d : { kind: "d"; }
>kind : "d"

    export default d;
>d : { kind: "d"; }
}

declare module "c:d" with { type: "css" } {
>"c:d" : typeof import("c:d")
>type : error

    const e: { kind: "e" };
>e : { kind: "e"; }
>kind : "e"

    export default e;
>e : { kind: "e"; }
}

declare module "d:e" {
>"d:e" : typeof import("d:e")

    const f: { kind: "f" };
>f : { kind: "f"; }
>kind : "f"

    export default f;
>f : { kind: "f"; }
}

=== b.ts ===
import a from "a:b" with { type: "css" };
