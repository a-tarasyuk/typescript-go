//// [tests/cases/conformance/importAttributes/importAttributes19.ts] ////

=== a.ts ===
declare module "a:b" with { "resolution-mode": "import" } {
>"a:b" : typeof import("a:b")

    export interface A {
        kind: "a";
>kind : "a"
    }
}

=== b.js ===
/** @import { A } from "a:b" with { "resolution-mode": "import" } */

/** @type {A} */
const a = { kind: "a" };
>a : A
>{ kind: "a" } : { kind: "a"; }
>kind : "a"
>"a" : "a"

=== c.ts ===
type B = import("a:b", { with: { "resolution-mode": "import" } }).A;
>B : A

declare const b: B;
>b : A

b satisfies { kind: "a" };
>b satisfies { kind: "a" } : A
>b : A
>kind : "a"

