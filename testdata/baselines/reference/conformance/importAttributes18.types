//// [tests/cases/conformance/importAttributes/importAttributes18.ts] ////

=== a.ts ===
declare module "*.css" with { type: "css" } {
>"*.css" : typeof import("*.css")
>type : error

    const a: { kind: "a" };
>a : { kind: "a"; }
>kind : "a"

    export default a;
>a : { kind: "a"; }
}

declare module "a:b" with { type: "json", mode: "raw" } {
>"a:b" : typeof import("a:b")
>type : error
>mode : error

    const b: { kind: "b" };
>b : { kind: "b"; }
>kind : "b"

    export default b;
>b : { kind: "b"; }
}

=== b.ts ===
declare module "*.css" with { type: "css" } {
>"*.css" : typeof import("*.css")
>type : error

    export const c: true;
>c : true
>true : true
}

declare module "a:b" with { mode: "raw", type: "json" } {
>"a:b" : typeof import("a:b")
>mode : error
>type : error

    export const d: true;
>d : true
>true : true
}

=== c.ts ===
import a, { c } from "./a.css" with { type: "css" };
>a : { kind: "a"; }
>c : true
>type : error

import b, { d } from "a:b" with { type: "json", mode: "raw" };
>b : { kind: "b"; }
>d : true
>type : error
>mode : error

a satisfies { kind: "a" };
>a satisfies { kind: "a" } : { kind: "a"; }
>a : { kind: "a"; }
>kind : "a"

b satisfies { kind: "b" };
>b satisfies { kind: "b" } : { kind: "b"; }
>b : { kind: "b"; }
>kind : "b"

c satisfies true;
>c satisfies true : true
>c : true
>true : true

d satisfies true;
>d satisfies true : true
>d : true
>true : true

